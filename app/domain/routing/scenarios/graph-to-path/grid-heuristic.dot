// Point-to-point across a 7 x 7 grid of 100 m lanes, from the middle of the
// west edge to the middle of the east edge. The only shortest path is the
// straight row; every detour adds at least 200 m. Dijkstra settles every node
// cheaper than 600 m in all directions; the Haversine heuristic keeps A* on
// the row, and graph-routing.test.ts counts the expansions to prove it.
//
// Nodes are named r<row>c<col> and carry x/y positions in metres; edge
// lengths follow from them. ("One-way" here means point-to-point; OSM
// oneway restrictions are not modelled.)
//
//   r6c0 -- r6c1 -- ... -- r6c6
//    |       |             |
//   ...     ...           ...
//    |       |             |
//   r3c0 -- r3c1 -- ... -- r3c6      start = r3c0, end = r3c6
//    |       |             |
//   ...     ...           ...
//    |       |             |
//   r0c0 -- r0c1 -- ... -- r0c6
//
graph grid_heuristic {
  graph [
    description = "A* guided by Haversine expands fewer nodes than Dijkstra on a grid",
    start = "r3c0",
    end = "r3c6",
    minDist = 0,
    maxDist = 5000,
    expect_route = "r3c0,r3c1,r3c2,r3c3,r3c4,r3c5,r3c6"
  ]

  r0c0 [x=0, y=0]
  r0c1 [x=100, y=0]
  r0c2 [x=200, y=0]
  r0c3 [x=300, y=0]
  r0c4 [x=400, y=0]
  r0c5 [x=500, y=0]
  r0c6 [x=600, y=0]
  r1c0 [x=0, y=100]
  r1c1 [x=100, y=100]
  r1c2 [x=200, y=100]
  r1c3 [x=300, y=100]
  r1c4 [x=400, y=100]
  r1c5 [x=500, y=100]
  r1c6 [x=600, y=100]
  r2c0 [x=0, y=200]
  r2c1 [x=100, y=200]
  r2c2 [x=200, y=200]
  r2c3 [x=300, y=200]
  r2c4 [x=400, y=200]
  r2c5 [x=500, y=200]
  r2c6 [x=600, y=200]
  r3c0 [x=0, y=300]
  r3c1 [x=100, y=300]
  r3c2 [x=200, y=300]
  r3c3 [x=300, y=300]
  r3c4 [x=400, y=300]
  r3c5 [x=500, y=300]
  r3c6 [x=600, y=300]
  r4c0 [x=0, y=400]
  r4c1 [x=100, y=400]
  r4c2 [x=200, y=400]
  r4c3 [x=300, y=400]
  r4c4 [x=400, y=400]
  r4c5 [x=500, y=400]
  r4c6 [x=600, y=400]
  r5c0 [x=0, y=500]
  r5c1 [x=100, y=500]
  r5c2 [x=200, y=500]
  r5c3 [x=300, y=500]
  r5c4 [x=400, y=500]
  r5c5 [x=500, y=500]
  r5c6 [x=600, y=500]
  r6c0 [x=0, y=600]
  r6c1 [x=100, y=600]
  r6c2 [x=200, y=600]
  r6c3 [x=300, y=600]
  r6c4 [x=400, y=600]
  r6c5 [x=500, y=600]
  r6c6 [x=600, y=600]

  r0c0 -- r0c1 [type=lane]
  r0c0 -- r1c0 [type=lane]
  r0c1 -- r0c2 [type=lane]
  r0c1 -- r1c1 [type=lane]
  r0c2 -- r0c3 [type=lane]
  r0c2 -- r1c2 [type=lane]
  r0c3 -- r0c4 [type=lane]
  r0c3 -- r1c3 [type=lane]
  r0c4 -- r0c5 [type=lane]
  r0c4 -- r1c4 [type=lane]
  r0c5 -- r0c6 [type=lane]
  r0c5 -- r1c5 [type=lane]
  r0c6 -- r1c6 [type=lane]
  r1c0 -- r1c1 [type=lane]
  r1c0 -- r2c0 [type=lane]
  r1c1 -- r1c2 [type=lane]
  r1c1 -- r2c1 [type=lane]
  r1c2 -- r1c3 [type=lane]
  r1c2 -- r2c2 [type=lane]
  r1c3 -- r1c4 [type=lane]
  r1c3 -- r2c3 [type=lane]
  r1c4 -- r1c5 [type=lane]
  r1c4 -- r2c4 [type=lane]
  r1c5 -- r1c6 [type=lane]
  r1c5 -- r2c5 [type=lane]
  r1c6 -- r2c6 [type=lane]
  r2c0 -- r2c1 [type=lane]
  r2c0 -- r3c0 [type=lane]
  r2c1 -- r2c2 [type=lane]
  r2c1 -- r3c1 [type=lane]
  r2c2 -- r2c3 [type=lane]
  r2c2 -- r3c2 [type=lane]
  r2c3 -- r2c4 [type=lane]
  r2c3 -- r3c3 [type=lane]
  r2c4 -- r2c5 [type=lane]
  r2c4 -- r3c4 [type=lane]
  r2c5 -- r2c6 [type=lane]
  r2c5 -- r3c5 [type=lane]
  r2c6 -- r3c6 [type=lane]
  r3c0 -- r3c1 [type=lane]
  r3c0 -- r4c0 [type=lane]
  r3c1 -- r3c2 [type=lane]
  r3c1 -- r4c1 [type=lane]
  r3c2 -- r3c3 [type=lane]
  r3c2 -- r4c2 [type=lane]
  r3c3 -- r3c4 [type=lane]
  r3c3 -- r4c3 [type=lane]
  r3c4 -- r3c5 [type=lane]
  r3c4 -- r4c4 [type=lane]
  r3c5 -- r3c6 [type=lane]
  r3c5 -- r4c5 [type=lane]
  r3c6 -- r4c6 [type=lane]
  r4c0 -- r4c1 [type=lane]
  r4c0 -- r5c0 [type=lane]
  r4c1 -- r4c2 [type=lane]
  r4c1 -- r5c1 [type=lane]
  r4c2 -- r4c3 [type=lane]
  r4c2 -- r5c2 [type=lane]
  r4c3 -- r4c4 [type=lane]
  r4c3 -- r5c3 [type=lane]
  r4c4 -- r4c5 [type=lane]
  r4c4 -- r5c4 [type=lane]
  r4c5 -- r4c6 [type=lane]
  r4c5 -- r5c5 [type=lane]
  r4c6 -- r5c6 [type=lane]
  r5c0 -- r5c1 [type=lane]
  r5c0 -- r6c0 [type=lane]
  r5c1 -- r5c2 [type=lane]
  r5c1 -- r6c1 [type=lane]
  r5c2 -- r5c3 [type=lane]
  r5c2 -- r6c2 [type=lane]
  r5c3 -- r5c4 [type=lane]
  r5c3 -- r6c3 [type=lane]
  r5c4 -- r5c5 [type=lane]
  r5c4 -- r6c4 [type=lane]
  r5c5 -- r5c6 [type=lane]
  r5c5 -- r6c5 [type=lane]
  r5c6 -- r6c6 [type=lane]
  r6c0 -- r6c1 [type=lane]
  r6c1 -- r6c2 [type=lane]
  r6c2 -- r6c3 [type=lane]
  r6c3 -- r6c4 [type=lane]
  r6c4 -- r6c5 [type=lane]
  r6c5 -- r6c6 [type=lane]
}
