// Two routes share every node except their terminal node.
// minDist=600 makes both leaves valid destinations, proving the complete
// node sequence participates in deduplication.
//
//                                D
//                               /
//   A --200m-- B --200m-- C --200m
//                               \
//                                E
//
graph terminal_fan_out {
  graph [
    description = "Routes that differ only at the terminal node remain distinct",
    start = "A",
    minDist = 600,
    maxDist = 5000,
    expect_minRoutes = 2,
    expect_route = "A,B,C,D;A,B,C,E"
  ]

  A -- B [distance=200, type=lane]
  B -- C [distance=200, type=lane]
  C -- D [distance=200, type=lane]
  C -- E [distance=200, type=lane]
}
