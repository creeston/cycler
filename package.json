{
  "name": "my-react-router-app",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  },
  "allowScripts": {},
  "scripts": {
    "build": "react-router build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run security:check",
    "deploy": "npm run build && gh-pages -d build/client",
    "dev": "react-router dev",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "security:check": "npm audit --audit-level=high",
    "security:signatures": "npm audit signatures",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"app/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@turf/turf": "^7.4.0",
    "clsx": "^2.1.1",
    "graphology": "^0.26.0",
    "graphology-shortest-path": "^2.1.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.41.0",
    "maplibre-gl": "^6.7.0",
    "osmtogeojson": "^3.0.0-beta.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-map-gl": "^8.1.3",
    "react-router": "8.3.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15",
    "isbot": "^5"
  },
  "devDependencies": {
    "@react-router/dev": "8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
